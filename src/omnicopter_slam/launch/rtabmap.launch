<launch>
  <arg name="database_path" default="/home/omni/.ros/mapping.db"/>
  <arg name="slam" default="true"/>
  <group ns="rtabmap">
    <node pkg="rtabmap_odom" type="rgbd_odometry" name="rgbd_odometry" output="screen">
      <param name="frame_id" value="base_link"/>
      <param name="odom_frame_id" value="visual_odom"/>
      <param name="publish_tf" value="false"/>
      <param name="approx_sync" value="false"/>
      <param name="topic_queue_size" value="1"/>
      <param name="sync_queue_size" value="5"/>
      <param name="wait_for_transform_duration" value="0.2"/>
      <!-- Use IMU attitude increments as the rotation prior for registration. -->
      <param name="wait_imu_to_init" value="true"/>
      <remap from="imu" to="/omnicopter/imu/data"/>
      <!-- Reinitialize registration from the fused odometry transform if relock fails. -->
      <param name="Odom/ResetCountdown" type="string" value="2"/>
      <!-- GFTT corners with ORB descriptors for small RGB-D frames. -->
      <param name="Vis/FeatureType" type="string" value="8"/>
      <param name="Vis/SSC" type="string" value="true"/>
      <param name="Vis/MaxFeatures" type="string" value="1500"/>
      <param name="Vis/MinInliers" type="string" value="15"/>
      <remap from="rgb/image" to="/mapping_camera/rgbd/rgb/image_raw"/>
      <remap from="depth/image" to="/mapping_camera/rgbd/depth/image_raw"/>
      <remap from="rgb/camera_info" to="/mapping_camera/rgbd/rgb/camera_info"/>
    </node>

    <node if="$(arg slam)" pkg="rtabmap_slam" type="rtabmap" name="rtabmap" output="screen">
      <param name="frame_id" value="base_link"/>
      <param name="map_frame_id" value="mapping_map"/>
      <param name="subscribe_depth" value="true"/>
      <param name="subscribe_rgb" value="true"/>
      <param name="subscribe_odom_info" value="true"/>
      <param name="approx_sync" value="true"/>
      <param name="topic_queue_size" value="1"/>
      <param name="sync_queue_size" value="5"/>
      <param name="database_path" value="$(arg database_path)"/>
      <param name="Rtabmap/DetectionRate" type="string" value="1"/>
      <param name="Kp/DetectorStrategy" type="string" value="2"/>
      <param name="Vis/FeatureType" type="string" value="2"/>
      <param name="Grid/Sensor" type="string" value="1"/>
      <param name="Grid/3D" type="string" value="true"/>
      <param name="Grid/CellSize" type="string" value="0.05"/>
      <param name="Grid/RangeMax" type="string" value="8.0"/>
      <remap from="rgb/image" to="/mapping_camera/rgbd/rgb/image_raw"/>
      <remap from="depth/image" to="/mapping_camera/rgbd/depth/image_raw"/>
      <remap from="rgb/camera_info" to="/mapping_camera/rgbd/rgb/camera_info"/>
    </node>

    <node if="$(arg slam)" pkg="rtabmap_viz" type="rtabmap_viz" name="rtabmap_viz" output="screen">
      <param name="frame_id" value="base_link"/>
      <param name="subscribe_depth" value="true"/>
      <param name="subscribe_odom_info" value="true"/>
      <param name="approx_sync" value="true"/>
      <param name="topic_queue_size" value="1"/>
      <param name="sync_queue_size" value="5"/>
      <remap from="rgb/image" to="/mapping_camera/rgbd/rgb/image_raw"/>
      <remap from="depth/image" to="/mapping_camera/rgbd/depth/image_raw"/>
      <remap from="rgb/camera_info" to="/mapping_camera/rgbd/rgb/camera_info"/>
    </node>
  </group>
</launch>
