#!/usr/bin/env bash
set -e
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
exec xpra start :100 --daemon=no --bind-tcp=0.0.0.0:8080 \
    --html=on --sharing=yes --mdns=no --notifications=no --pulseaudio=no \
    --webcam=no --printing=no --opengl=no \
    --start-child=omni-sim --start-child="xterm -fa Monospace -fs 11"
